{
  "protocol_version": "1.0",
  "date": "2026-05-15",
  "tactical_modes": ["on", "off"],
  "pairing_constraints": {
    "shared": ["seed", "scenario", "map", "player_info", "agent_config"],
    "varied": ["tactical_mode"]
  },
  "evaluation_size": {
    "target_seeds": 5,
    "min_seeds": 3,
    "target_scenarios": 3,
    "min_scenarios": 2,
    "replay_windows": 1
  },
  "scenarios": [
    {"id": "1231", "file": "1231.json", "map": "map_123", "difficulty": "standard"},
    {"id": "1531", "file": "1531.json", "map": "map_53", "difficulty": "standard"},
    {"id": "1910631192", "file": "1910631192.json", "map": "map_19", "difficulty": "standard"}
  ],
  "seeds": [0, 1, 2, 3, 4],
  "metrics": {
    "primary": ["win_rate", "score_delta", "rating_delta"],
    "secondary": ["action_divergence_count", "tactical_invocation_count", "route_empty_rate", "move_success_rate", "policy_fallback_rate", "replay_completion_rate"],
    "reliability": ["crash_count", "replay_abort_rate", "invalid_action_count"]
  },
  "statistical_methods": {
    "paired_difference": true,
    "bootstrap_ci": {"n_resamples": 1000, "confidence_level": 0.95},
    "effect_size": "cohens_d"
  },
  "transparency": {
    "report_attempted": true,
    "report_completed": true,
    "report_failed": true,
    "report_excluded": true,
    "report_exclusion_reasons": true,
    "no_hidden_filtering": true
  },
  "outputs": {
    "per_game_metrics": "per_game_metrics/",
    "paired_results": "paired_results.json",
    "bootstrap_statistics": "bootstrap_statistics.json"
  }
}
