{
  "dataset": "Shenji",
  "plan_name": "collection_plan_v2",
  "version": "2.0.0",
  "description": "v2 collection plan. Key changes from v1: controllers per class raised to 5-8, single-controller cap tightened to 20-25%, collection targets stated in effective sample units (episodes/scenarios/controllers/maps) not just segment counts, BACKGROUND/UNKNOWN quotas added, FEINT and rare-class quotas separated.",
  "changelog_v2": [
    "Controllers per class: minimum raised from 3 to 5, target 5-8",
    "Single controller contribution cap: tightened from 50% to 20-25%",
    "Added BACKGROUND/UNKNOWN non-intent segment quotas",
    "FEINT and rare-class intents get independent quotas",
    "Collection targets now stratified by episode, scenario_family, controller_family, map_family",
    "Effective sample size reported: intra-episode segment correlations acknowledged",
    "Quality constraints expanded to cover open-set and human-inferred tracks"
  ],
  "max_steps": 1000,
  "global_constraints": {
    "min_map_families": 5,
    "min_scenario_families": 3,
    "min_controller_families": 3,
    "per_intent_min_controllers": 5,
    "per_intent_target_controllers": 8,
    "max_single_controller_share": 0.25,
    "pilot_min_episodes_per_intent": 3,
    "v1_min_episodes_per_intent": 15,
    "failure_or_switch_min_share": 0.20,
    "background_min_share": 0.05,
    "unknown_min_share_per_map": 0.03,
    "human_inferred_audit_segments": 1000,
    "ood_held_out_map_families": 2,
    "ood_held_out_policies": 1,
    "open_set_abstention_rate_target": 0.05
  },
  "per_intent_targets": {
    "ASSAULT": {"pilot_min_segments": 40, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": true},
    "BREAKTHROUGH": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": true},
    "FLANK": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": true},
    "ENCIRCLEMENT": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure","switch"], "failure_or_switch_required": true},
    "PURSUIT": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": true},
    "AMBUSH": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure","switch"], "failure_or_switch_required": true},
    "SEIZE": {"pilot_min_segments": 40, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": false},
    "HOLD": {"pilot_min_segments": 40, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": false},
    "INTERDICT": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure","switch"], "failure_or_switch_required": true},
    "RECON": {"pilot_min_segments": 40, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": false},
    "SURVEILLANCE": {"pilot_min_segments": 60, "pilot_min_episodes": 3, "v1_min_segments": 500, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": false},
    "TARGET_GUIDANCE": {"pilot_min_segments": 40, "pilot_min_episodes": 3, "v1_min_segments": 400, "controllers_required": 5, "controllers_target": 8, "map_families_min": 3, "scenario_families_min": 2, "min_outcomes": ["success","failure"], "failure_or_switch_required": false},
