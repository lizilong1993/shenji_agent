# Credentials: Tianditu key, Cesium ion token, and anything else third-party.
# Keys live in .env (server reads it; see .env.example for the template) and
# must never enter git. The previously hard-coded Tianditu key had to be
# rotated precisely because it was in a tracked file.
.env
.env.local

# Third-party vendor bundle (45 MB unpacked). Pinned and fetched by
# tools/fetch_cesium.sh instead of being committed.
web/vendor/

# Generated situation data. Deterministic output of
# scripts/gen_demo_trajectory.py -- regenerate rather than commit.
# `web/data/*.json` 只匹配 direct children：目录化之后 `web/data/situations/*.json`
# **不在覆盖范围内**，数据集会变成可被误提交。两层都写死，别只靠通配符。
web/data/*.json
web/data/situations/

# Offline tile set (~10k files, ~200 MB), rebuilt by tools/fetch_assets.py and
# tools/fetch_urban_wsf3d.sh. Never commit this.
web/tiles/

# Local verification captures
tools/shots/

# 发布的瓦片库（mbtiles）。上传的原始瓦片按库直发，不再摊成文件树——
# 本机文件系统建小文件只有 17-59 个/秒（见 server/serve.py 的注释）。
tiles_db/

# 3D Tiles / quantized-mesh 数据集（zip 直发，见 server/serve.py）
tiles3d_db/

# 战役地图由 scripts/build_campaign_map.py 生成（OSM/DEM 派生，体积大）
web/data/campaign_maps/
